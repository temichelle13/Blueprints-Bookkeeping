{
  "name": "@workspace/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build:analyze": "vite build --config vite.config.ts --mode analyze",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -b ../../lib/api-client-react ../../lib/api-zod && tsc -p tsconfig.json --noEmit",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts",
    "sitemap:check": "tsx scripts/generate-sitemap.ts --check",
    "prebuild": "pnpm run sitemap:generate",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "optimize:images": "node scripts/convert-images-to-webp.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "catalog:",
    "web-vitals": "^6.2.1",
    "wouter": "^3.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "sharp": "^0.35.4",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
